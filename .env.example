# Copy to .env.local for `vercel dev`, and add the same values in the Vercel dashboard.
# These are server-only secrets. Do NOT prefix them with VITE_ (that would expose them in the browser).
RESEND_API_KEY=
SPONSOR_INBOX=
SPONSOR_FROM="ElleHacks Website <no-reply@your-verified-domain.com>"

# Optional: point the form at a different endpoint (defaults to /api/sponsor-inquiry).
# VITE_SPONSOR_ENDPOINT=
